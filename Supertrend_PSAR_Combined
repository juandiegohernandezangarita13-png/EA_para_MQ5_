#property indicator_chart_window
#property indicator_buffers 8
#property indicator_plots   5

//--- Plot 1: Supertrend Up (Soporte / Tendencia Alcista)
#property indicator_label1  "Supertrend Up"
#property indicator_type1   DRAW_LINE
#property indicator_color1  clrLimeGreen
#property indicator_style1  STYLE_SOLID
#property indicator_width1  2

//--- Plot 2: Supertrend Down (Resistencia / Tendencia Bajista)
#property indicator_label2  "Supertrend Down"
#property indicator_type2   DRAW_LINE
#property indicator_color2  clrRed
#property indicator_style2  STYLE_SOLID
#property indicator_width2  2

//--- Plot 3: Parabolic SAR (Puntos)
#property indicator_label3  "PSAR"
#property indicator_type3   DRAW_ARROW
#property indicator_color3  clrDodgerBlue
#property indicator_width3  2

//--- Plot 4: Señal de Compra (Buy)
#property indicator_label4  "Buy"
#property indicator_type4   DRAW_ARROW
#property indicator_color4  clrLimeGreen
#property indicator_width4  2

//--- Plot 5: Señal de Venta (Sell)
#property indicator_label5  "Sell"
#property indicator_type5   DRAW_ARROW
#property indicator_color5  clrRed
#property indicator_width5  2

//--- Parámetros de Entrada (Fijados según requisitos)
input string   Grp1 = "=== SUPERTREND ===";
input int      InpAtrLength = 2;      // Longitud ATR
input double   InpAtrFactor = 10;     // Factor Multiplicador

input string   Grp2 = "=== PSAR ===";
input double   InpPsarStep = 0.1;      // Equivalente matemático al incremento 200 con tope
input double   InpPsarMax = 0.19;      // Máximo Absoluto

//--- Buffers de Datos (Gráficos)
double BufferSTUp[];
double BufferSTDn[];
double BufferPSAR[];
double BufferBuy[];
double BufferSell[];

//--- Buffers de Cálculo (Ocultos a la vista)
double BufferTrend[];
double BufferUpperBand[];
double BufferLowerBand[];

//--- Handles para cálculos nativos
int handle_atr;
int handle_sar;

//+------------------------------------------------------------------+
//| Custom indicator initialization function                         |
//+------------------------------------------------------------------+
int OnInit()
  {
   // Mapeo de buffers
   SetIndexBuffer(0, BufferSTUp, INDICATOR_DATA);
   SetIndexBuffer(1, BufferSTDn, INDICATOR_DATA);
   SetIndexBuffer(2, BufferPSAR, INDICATOR_DATA);
   SetIndexBuffer(3, BufferBuy, INDICATOR_DATA);
   SetIndexBuffer(4, BufferSell, INDICATOR_DATA);
   SetIndexBuffer(5, BufferTrend, INDICATOR_CALCULATIONS);
   SetIndexBuffer(6, BufferUpperBand, INDICATOR_CALCULATIONS);
   SetIndexBuffer(7, BufferLowerBand, INDICATOR_CALCULATIONS);

   // Configuración de estilo visual
   PlotIndexSetInteger(2, PLOT_ARROW, 159); // Código de punto pequeño
   PlotIndexSetInteger(3, PLOT_ARROW, 233); // Flecha hacia arriba
   PlotIndexSetInteger(4, PLOT_ARROW, 234); // Flecha hacia abajo

   // Limpiar valores vacíos para que no dibujen en cero
   PlotIndexSetDouble(0, PLOT_EMPTY_VALUE, 0.0);
   PlotIndexSetDouble(1, PLOT_EMPTY_VALUE, 0.0);
   PlotIndexSetDouble(2, PLOT_EMPTY_VALUE, 0.0);
   PlotIndexSetDouble(3, PLOT_EMPTY_VALUE, 0.0);
   PlotIndexSetDouble(4, PLOT_EMPTY_VALUE, 0.0);

   // Carga de manejadores (Handles)
   handle_atr = iATR(_Symbol, _Period, InpAtrLength);
   handle_sar = iSAR(_Symbol, _Period, InpPsarStep, InpPsarMax);

   if(handle_atr == INVALID_HANDLE || handle_sar == INVALID_HANDLE)
     {
      Print("Error crítico: Fallo al cargar los manejadores del sistema.");
      return(INIT_FAILED);
     }

   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Custom indicator iteration function                              |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double &open[],
                const double &high[],
                const double &low[],
                const double &close[],
                const long &tick_volume[],
                const long &volume[],
                const int &spread[])
  {
   // Evitar cálculos si no hay suficientes velas para el ATR
   if(rates_total < InpAtrLength) return 0;

   int limit = prev_calculated - 1;
   if(limit < 1)
     {
      limit = 1;
      ArrayInitialize(BufferSTUp, 0.0);
      ArrayInitialize(BufferSTDn, 0.0);
      ArrayInitialize(BufferUpperBand, 0.0);
      ArrayInitialize(BufferLowerBand, 0.0);
      ArrayInitialize(BufferTrend, 1.0);
      ArrayInitialize(BufferBuy, 0.0);
      ArrayInitialize(BufferSell, 0.0);
     }

   // Matrices temporales para copiar datos nativos
   double atr[];
   double sar[];
   
   if(CopyBuffer(handle_atr, 0, 0, rates_total, atr) <= 0) return 0;
   if(CopyBuffer(handle_sar, 0, 0, rates_total, sar) <= 0) return 0;

   // Bucle principal de procesamiento
   for(int i = limit; i < rates_total; i++)
     {
      // 1. Asignación del PSAR y Señales
      BufferPSAR[i] = sar[i];
      BufferBuy[i]  = 0.0;
      BufferSell[i] = 0.0;

      if(i > 0)
        {
         // Detección de Cruce Alcista (Punto PSAR salta de arriba hacia abajo del precio de cierre)
         if(sar[i-1] > close[i-1] && sar[i] < close[i])
           {
            // Separación dinámica basada en la volatilidad del activo (ATR)
            BufferBuy[i] = low[i] - (atr[i] * 0.5); 
           }
         // Detección de Cruce Bajista (Punto PSAR salta de abajo hacia arriba del precio de cierre)
         else if(sar[i-1] < close[i-1] && sar[i] > close[i])
           {
            BufferSell[i] = high[i] + (atr[i] * 0.5);
           }
        }

      // 2. Procesamiento de la Matriz del Supertrend
      double hl2 = (high[i] + low[i]) / 2.0;
      double basic_ub = hl2 + (InpAtrFactor * atr[i]);
      double basic_lb = hl2 - (InpAtrFactor * atr[i]);

      double prev_ub = BufferUpperBand[i-1];
      double prev_lb = BufferLowerBand[i-1];

      // Compresión de bandas para definir zonas inviolables
      BufferUpperBand[i] = (basic_ub < prev_ub || close[i-1] > prev_ub) ? basic_ub : prev_ub;
      BufferLowerBand[i] = (basic_lb > prev_lb || close[i-1] < prev_lb) ? basic_lb : prev_lb;

      // Evaluación del régimen de tendencia actual
      int current_trend = (int)BufferTrend[i-1];
      
      if(close[i] > BufferUpperBand[i])
         current_trend = 1;  // Quiebre al alza
      else if(close[i] < BufferLowerBand[i])
         current_trend = -1; // Quiebre a la baja

      BufferTrend[i] = current_trend;

      // Dibujado del Supertrend
      if(current_trend == 1)
        {
         BufferSTUp[i] = BufferLowerBand[i];
         BufferSTDn[i] = 0.0;
        }
      else
        {
         BufferSTUp[i] = 0.0;
         BufferSTDn[i] = BufferUpperBand[i];
        }
     }

   return(rates_total);
  }
